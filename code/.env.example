# Copy this file to .env and fill in real values.
# .env itself is gitignored and must never be committed.

# ---- Database -------------------------------------------------------------
# Postgres connection string used by both the API and Alembic.
DATABASE_URL=postgresql+psycopg://silo:silo@localhost:5432/silo

# ---- Session signing ------------------------------------------------------
# Signs the silo_session JWT cookie. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-random-value

# ---- Google OAuth ---------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth 2.0 Client ID (type: Web application).
# Add OAUTH_REDIRECT_URI below to that client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# ---- Frontend origin ------------------------------------------------------
# Used for the CORS allow-list and for post-login redirects.
WEB_ORIGIN=http://localhost:3000

# ---- Uploaded app bundles -------------------------------------------------
# Where uploaded projects are extracted. Deliberately OUTSIDE apps/api so
# uvicorn's --reload watcher never sees an upload as a source change (that
# used to restart the API mid-build and kill the build).
# Relative paths resolve against the directory you start the API from.
BUNDLE_STORAGE_PATH=../../.silo_data/bundles

# Local account sign-in is opt-in. The local development launcher enables it.
LOCAL_AUTH_ENABLED=false
COOKIE_SECURE=false
# Use independent random secrets for hosted services. Never use NEXT_PUBLIC_* for secrets.
COLLAB_SERVICE_SECRET=
COLLAB_URL=http://127.0.0.1:1234
COLLAB_PUBLIC_URL=ws://localhost:1234
# ---- AI (optional) -------------------------------------------------------
# Silo's AI writes code changes for review (Workbench "Ask AI", Security track
# "Fix with AI"). Two ways to enable it; with both, the local model answers
# and Gemini is the backup when the local model is not running.
#
# 1. Local model on this computer (no key, nothing leaves the machine).
#    See apps/local-ai/README.md. scripts/start.py starts it for you.
AI_API_URL=http://127.0.0.1:8090/v1/chat/completions
AI_MODEL=gemma-4-e4b
SILO_AI_HOME=D:/silo-ai
SILO_AI_MODEL=D:/models/silo/gemma-4-e4b/gemma-4-E4B_q4_0-it.gguf
SILO_AI_PORT=8090
#
# 2. Gemini: a key from https://aistudio.google.com/apikey. On its own it uses
#    Google's OpenAI-compatible endpoint and the model gemini-3.8-flash.
GEMINI_API_KEY=
#
# Another OpenAI-style cloud provider: set AI_API_URL, AI_MODEL and AI_API_KEY.
AI_API_KEY=
# low | medium | high reasoning for Gemini (default low).
AI_REASONING_EFFORT=
