---
config:
  theme: base
  themeVariables:
    primaryColor: '#fff8c4'
    primaryBorderColor: '#7a6a12'
    primaryTextColor: '#1a1a1a'
    lineColor: '#333333'
    fontSize: '15px'
---
flowchart TB

subgraph DEV["DEVELOPER / COLLABORATOR"]
  direction TB
  START(( )):::start
  D1["Sign in with Google"]
  D2["Create app and upload<br/>.py or .zip"]
  D3["Read rejection reason"]
  D4["Open live app"]
  D5["Read build logs"]
  D6["Open shared workbench"]
  D7["Request change via AI<br/>or comment on draft"]
  D8["Publish draft as<br/>new version"]
  ENDA(((" "))):::done
  ENDB(((" "))):::done
  ENDC(((" "))):::done
end

subgraph API["PLATFORM API"]
  direction TB
  P1["Store bundle<br/>version = analysing"]
  P2["Serve app via /proxy/id"]
  P3["Apply change to draft"]
  P4["Log event in audit trail"]
end

subgraph ANA["ANALYSIS ENGINE"]
  direction TB
  N0["Run Semgrep rules<br/>and AST scan"]
  F1[" "]:::bar
  N1["Infer build plan<br/>entry, deps, port"]
  N2["Generate nutrition label<br/>files, network, subprocess"]
  J1[" "]:::bar
end

subgraph APR["APPROVER"]
  direction TB
  R1["Review nutrition label"]
  R2{"Approve or<br/>reject?"}
  R3["Record rejection<br/>and reason"]:::bad
end

subgraph SBX["SANDBOX RUNTIME"]
  direction TB
  S1["Build image from plan"]
  S2["Run in gVisor sandbox<br/>CPU and memory caps"]
  S3["Apply egress allowlist,<br/>route via capability broker"]
  S4{"Port responds?"}
  S5["Mark version live"]:::ok
  S6["Mark version failed,<br/>attach output"]:::bad
end

START --> D1 --> D2 --> P1 --> N0 --> F1
F1 --> N1
F1 --> N2
N1 --> J1
N2 --> J1
J1 --> R1 --> R2
R2 -- reject --> R3 --> D3 --> ENDA
R2 -- approve --> S1 --> S2 --> S3 --> S4
S4 -- no --> S6 --> D5 --> ENDB
S4 -- yes --> S5 --> P2 --> D4 --> D6 --> D7 --> P3 --> D8 --> P4 --> ENDC

classDef start fill:#000000,stroke:#000000,color:#ffffff
classDef done fill:#ffffff,stroke:#000000,stroke-width:4px,color:#000000
classDef bar fill:#000000,stroke:#000000,color:#000000
classDef ok fill:#d7f5e5,stroke:#16a34a,color:#052e1a
classDef bad fill:#fde2e2,stroke:#dc2626,color:#450a0a

style DEV fill:#ffffff,stroke:#333333,stroke-width:1.5px
style API fill:#ffffff,stroke:#333333,stroke-width:1.5px
style ANA fill:#ffffff,stroke:#333333,stroke-width:1.5px
style APR fill:#ffffff,stroke:#333333,stroke-width:1.5px
style SBX fill:#ffffff,stroke:#333333,stroke-width:1.5px
